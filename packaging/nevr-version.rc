#ifndef NEVR_VERSION_MAJOR
#define NEVR_VERSION_MAJOR 0
#endif
#ifndef NEVR_VERSION_MINOR
#define NEVR_VERSION_MINOR 0
#endif
#ifndef NEVR_VERSION_PATCH
#define NEVR_VERSION_PATCH 0
#endif

#define NEVR_STRINGIFY_INNER(value) #value
#define NEVR_STRINGIFY(value) NEVR_STRINGIFY_INNER(value)
#define NEVR_VERSION_TEXT NEVR_STRINGIFY(NEVR_VERSION_MAJOR) "." NEVR_STRINGIFY(NEVR_VERSION_MINOR) "." NEVR_STRINGIFY(NEVR_VERSION_PATCH)

1 ICON "packaging/assets/nevr.ico"

1 VERSIONINFO
FILEVERSION NEVR_VERSION_MAJOR,NEVR_VERSION_MINOR,NEVR_VERSION_PATCH,0
PRODUCTVERSION NEVR_VERSION_MAJOR,NEVR_VERSION_MINOR,NEVR_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "MyGuyChromium"
      VALUE "FileDescription", "NEVR-Anticheat replay intelligence console"
      VALUE "FileVersion", NEVR_VERSION_TEXT
      VALUE "InternalName", "nevr-desktop"
      VALUE "OriginalFilename", "nevr-desktop.exe"
      VALUE "ProductName", "NEVR-Anticheat"
      VALUE "ProductVersion", NEVR_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
